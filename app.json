{
  "expo": {
    "name": "Convergence",
    "slug": "convergence",
    "scheme": "convergence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/convergence-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/convergence-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080D1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.bluetoothcompanion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/convergence-icon.png",
        "backgroundColor": "#080D1A"
      },
      "package": "com.anonymous.bluetoothcompanion"
    },
    "plugins": [
      "expo-system-ui",
      "expo-secure-store",
      ["@clerk/expo", { "appleSignIn": false, "theme": "./clerk-theme.json" }]
    ]
  }
}
